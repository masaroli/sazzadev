<script>
  import CoreComponent from "../../../utils/CoreComponent";
  import * as THREE from "three";
  import gsap from "gsap";

  class CrtEffectComponent extends CoreComponent {
    private renderer: THREE.WebGLRenderer | null = null;
    private scene: THREE.Scene | null = null;
    private camera: THREE.OrthographicCamera | null = null;
    private uniforms: { [uniform: string]: THREE.IUniform };
    private animationId: number | null = null;

    constructor(element: HTMLElement) {
      super(element);

      this.uniforms = {
        u_time: { value: 0.0 },
        u_resolution: {
          value: new THREE.Vector2(window.innerWidth, window.innerHeight),
        },
      };
      this.init();
    }

    private readonly init = () => {
      const canvas = this.getElement(
        '[data-element="crt-effect"]',
      ) as HTMLCanvasElement;
      if (!canvas) {
        console.error("CRT Canvas not found inside wrapper!");
        return;
      }
      this.scene = new THREE.Scene();
      this.camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

      // Detect mobile device
      const isMobile =
        /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
          navigator.userAgent,
        );

      this.renderer = new THREE.WebGLRenderer({
        canvas: canvas,
        alpha: true,
        antialias: false, // Disable antialiasing on all devices
        powerPreference: "high-performance", // Request high-performance GPU
      });

      this.renderer.setSize(window.innerWidth, window.innerHeight);

      // Limit pixel ratio - crucial for mobile performance
      const pixelRatio = isMobile ? 1 : Math.min(window.devicePixelRatio, 1.5);
      this.renderer.setPixelRatio(pixelRatio);

      const geometry = new THREE.PlaneGeometry(2, 2);
      const material = new THREE.ShaderMaterial({
        uniforms: this.uniforms,
        vertexShader: `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform float u_time;
          uniform vec2 u_resolution;
          varying vec2 vUv;

          // Simplified random function
          float random(vec2 st) {
              return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);
          }

          void main() {
              vec2 distortedUv = vUv - 0.5;
              float r2 = dot(distortedUv, distortedUv);
              distortedUv *= 1.0 + 0.05 * r2;
              distortedUv += 0.5;

              vec3 color = vec3(0.05, 0.10, 0.05);

              // Simplified edge check
              if (distortedUv.x < 0.0 || distortedUv.x > 1.0 || distortedUv.y < 0.0 || distortedUv.y > 1.0) {
                  color = vec3(0.0);
              }

              // Reduced scanline frequency for better performance
              float scanline = sin(distortedUv.y * 400.0) * 0.04;
              color -= scanline;

              // Optimized vignette calculation
              float vignette = 1.0 - distance(distortedUv, vec2(0.5)) * 0.5;
              color *= vignette;
              
              // Reduce noise calculation frequency
              float noise = (random(distortedUv + floor(u_time * 10.0) * 0.1) - 0.5) * 0.1;
              color += noise;

              gl_FragColor = vec4(color, 1.0);
          }
        `,
        transparent: true,
        precision: "mediump", // Use medium precision for better mobile performance
      });

      const mesh = new THREE.Mesh(geometry, material);
      this.scene.add(mesh);

      const clock = new THREE.Clock();
      const animate = () => {
        this.uniforms.u_time.value = clock.getElapsedTime();
        this.renderer?.render(this.scene!, this.camera!);
        this.animationId = requestAnimationFrame(animate);
      };
      animate();

      window.addEventListener("resize", this.handleResize);
    };

    private readonly handleResize = () => {
      if (!this.renderer || !this.camera) return;
      this.renderer.setSize(window.innerWidth, window.innerHeight);
      this.uniforms.u_resolution.value.set(
        window.innerWidth,
        window.innerHeight,
      );
    };

    public destroy() {
      window.removeEventListener("resize", this.handleResize);
      if (this.animationId !== null) {
        cancelAnimationFrame(this.animationId);
      }
      this.renderer?.dispose();
      this.scene?.clear();
    }
  }

  document
    .querySelectorAll('[data-element="crt-wrapper"]')
    .forEach((element) => {
      new CrtEffectComponent(element as HTMLElement);
    });
</script>
<div data-element="crt-wrapper">
  <canvas data-element="crt-effect"></canvas>
</div>

<style>
  /* This CSS makes the canvas a fixed overlay on top of your entire site */
  [data-element="crt-wrapper"] {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 9999;
    pointer-events: none;
    mix-blend-mode: screen;

    /* This is the key for the intro animation! */
    /* It starts as a tiny dot in the center, completely hidden. */
    /* clip-path: circle(0% at 50% 50%); */
  }
  [data-element="crt-effect"] {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
