<script>
  import CoreComponent from "../../../utils/CoreComponent";
  import gsap from "gsap";

  class LogoSz extends CoreComponent {
    constructor(element: HTMLElement) {
      super(element);
      this.init();
    }

    private readonly init = () => {
      const tl = gsap.timeline({
        repeat: -1,
        yoyo: true,
        repeatDelay: 3,
        defaults: {
          ease: "rough",
        },
      });

      tl.to(this.getElement('[id="1"]'), { attr: { x: 0 } }, 0);
      tl.to(this.getElement('[id="2"]'), { attr: { x: 0 } }, 0.2);
      tl.to(this.getElement('[id="3"]'), { attr: { x: 134.82 * 2 } }, 0.1);
      tl.to(this.getElement('[id="4"]'), { attr: { x: 134.82 * 2 } }, 0.3);
    };
  }

  document.querySelectorAll('[data-element="logo-sz"]').forEach((element) => {
    new LogoSz(element as HTMLElement);
  });
</script>

<svg
  data-element="logo-sz"
  xmlns="http://www.w3.org/2000/svg"
  version="1.1"
  viewBox="0 0 404.44 720"
  width="40px"
  fill="white"
>
  <g>
    <rect y="600" width="404.44" height="120"></rect>
    <rect width="404.44" height="120"></rect>
  </g>
  <rect id="1" x="269.63" y="240" width="134.81" height="120"></rect>
  <rect id="2" x="269.63" y="120" width="134.81" height="120"></rect>
  <rect id="3" x="0" y="480" width="134.81" height="120"></rect>
  <rect id="4" x="0" y="360" width="134.81" height="120"></rect>
</svg>
